# Copie este arquivo para .env e ajuste os valores de produção.

# Porta da API
PORT=3001

# Segredo usado para assinar os tokens JWT.
# Em produção, gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Validade do token de login (ex.: 12h, 8h, 1d)
TOKEN_EXPIRES_IN=12h

# Caminho do banco de dados SQLite (produção: use caminho absoluto)
DB_PATH=./server/data/field.db

# Diretório de uploads de fotos e assinaturas
UPLOADS_DIR=./server/uploads

# Diretório de backups (usado pelo npm run backup)
BACKUP_DIR=./backups

# Origens permitidas para CORS (separadas por vírgula).
# Vazio = liberado (apenas desenvolvimento). Em produção, informe ex.:
# CORS_ORIGINS=https://field2.suadominio.com
CORS_ORIGINS=
